# usched configuration. Copy to .env; every value is optional.

# Advisor model. With GEMINI_API_KEY set the advisor uses Gemini, otherwise a
# local Ollama daemon. USCHED_LLM_PROVIDER forces one (gemini or ollama).
# USCHED_LLM_PROVIDER=gemini

# Gemini (hosted deployments): a free key from https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Ollama (local development)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
