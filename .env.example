# usched configuration. Copy to .env and fill in what you use.

# Dev server ports (npm run dev).
PORT=18800
CLIENT_PORT=18801

# Advisor: Gemini, with a free key from https://aistudio.google.com. Without
# a key, everything but the advisor works. GEMINI_MODELS is an ordered list;
# later models take over while earlier ones are busy or out of free-tier
# quota (each has its own). Flash-Lite allows 15 requests a minute per model
# on the free tier, Flash only 5.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
