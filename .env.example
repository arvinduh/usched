# usched configuration. Copy to .env and fill in what you use.

# Dev server ports (npm run dev).
PORT=18800
CLIENT_PORT=18801

# Advisor. With GEMINI_API_KEY set it uses Gemini, otherwise Ollama;
# USCHED_LLM_PROVIDER=gemini|ollama forces one.

# Gemini: a free key from https://aistudio.google.com. GEMINI_MODELS is an
# ordered list; later models take over while earlier ones are busy or out of
# free-tier quota (each has its own). Flash-Lite allows 15 requests a minute
# per model on the free tier, Flash only 5.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Ollama (local): any model you have pulled, e.g. `ollama pull qwen3.5:4b`.
# OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
